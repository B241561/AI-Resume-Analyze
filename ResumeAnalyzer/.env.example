# Optional Gemini AI analysis. Leave blank for local-only analysis.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Resume file limit in MB.
MAX_PDF_MB=5

# OCR settings for scanned PDFs.
OCR_ENABLED=true
# On Windows, use a path such as:
# TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
TESSERACT_CMD=
