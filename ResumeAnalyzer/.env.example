# Optional Groq AI analysis. Leave the key blank for local-only analysis.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Resume file limit in MB.
MAX_PDF_MB=5

# OCR settings for scanned PDFs.
OCR_ENABLED=true
# On Windows, use a path such as:
# TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
TESSERACT_CMD=
